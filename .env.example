# Copie para ".env" e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API). Use SOMENTE a chave "publishable/anon".
# NUNCA coloque a chave "service_role" ou "sb_secret_" neste projeto.
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="SEU-PROJETO"

# Usadas pelo servidor (SSR) — mesmos valores acima
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_PROJECT_ID="SEU-PROJETO"
